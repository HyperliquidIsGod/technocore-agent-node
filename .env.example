# 어디로 추론을 보낼지. 지금은 Anthropic, Q4 파우셋이 열리면 여기 세 줄이 바뀐다.
INFERENCE_PROVIDER=anthropic
INFERENCE_BASE_URL=https://api.anthropic.com
INFERENCE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...

# FLOP 추론 네트워크가 OpenAI 호환 엔드포인트를 내밀 경우:
# INFERENCE_PROVIDER=openai
# INFERENCE_BASE_URL=https://<파우셋이 알려주는 주소>
# INFERENCE_MODEL=<모델 이름>
# INFERENCE_API_KEY=<발급받은 키>
